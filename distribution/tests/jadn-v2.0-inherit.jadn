{
  "meta": {
    "package": "http://example.com/jadn-2.0",
    "description": "Test type inheritance options: extends, restricts, abstract, final",
    "roots": ["Base"]
  },

  "types": [
    ["Base", "Record", ["a"], "Abstract type, cannot be instantiated", [
      [1, "id", "Integer", ["K"], "Primary key"],
      [2, "name", "String", ["[0"], ""]
    ]],

    ["Base2", "Record", ["f"], "Final type, cannot be extended or restricted", [
      [1, "id", "Integer", ["K"], "Primary key"],
      [2, "name", "String", ["[0"], ""]
    ]],

    ["Base3", "Record", ["a", "f"], "Abstract final type: Error - cannot be instantiated or extended", [
      [1, "id", "Integer", ["K"], "Primary key"],
      [2, "name", "String", ["[0"], ""]
    ]],

    ["Person", "Record", ["eBase"], "Add new field", [
      [1, "email", "String", ["/email"], ""]
    ]],

    ["Building1", "Record", ["rBase"], "Remove optional field", [
      [2, "name", "String", ["]0"], "max cardinality 0 - removed"]
    ]],

    ["Building2", "Record", ["rBase"], "Error - remove required field", [
      [1, "id", "Integer", ["]0"], "cannot be both required and not allowed"]
    ]],

    ["Building3", "Record", ["rBase"], "Error - restrictions cannot add new fields", [
      [2, "name", "String", ["]0"], "not allowed"],
      [3, "building_id", "String", [], ""]
    ]]
  ]
}
