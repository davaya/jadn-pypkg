{
  "meta": {
    "package": "http://example.com/jadn-2.0",
    "description": "Test type inheritance options: extends, restricts, abstract, final",
    "roots": ["Class1", "Class2", "Class3"]
  },

  "types": [
    ["Class1", "Record", ["a"], "Abstract type, cannot be instantiated", [
      [1, "id", "Integer", ["K"], "Primary key"],
      [2, "name", "String", ["[0"], ""]
    ]],

    ["Class2", "Record", ["f"], "Final type, cannot be extended or restricted", [
      [1, "id", "Integer", ["K"], "Primary key"],
      [2, "name", "String", ["[0"], ""]
    ]],

    ["Class3", "Record", ["a", "f"], "Abstract final type: Error - cannot be instantiated or extended", [
      [1, "id", "Integer", ["K"], "Primary key"],
      [2, "name", "String", ["[0"], ""]
    ]],

    ["Person1", "Record", ["eClass1"], "Add new field", [
      [3, "email", "String", ["/email"], "Required email address"]
    ]],

    ["Person2", "Record", ["a", "eClass1"], "Add new field to make abstract type", [
      [3, "email", "String", ["/email"], ""]
    ]],

    ["Person3", "Record", ["eClass2"], "Err - can't extend final type", [
      [3, "email", "String", ["/email"], ""]
    ]],

    ["Person4", "Record", ["eClass1"], "Err - extend cannot remove fields", [
      [2, "name", "String", ["[0", "]0"], "max cardinality 0 - remove"]
    ]],

    ["Person5", "Record", ["ePerson1"], "Second level", [
      [4, "phone", "String", ["[0"], "Optional phone number"]
    ]],

    ["Person6", "Record", ["ePerson1"], "Err - extension can't restrict", [
      [2, "name", "String", ["[1"], "Require name"]
    ]],

    ["Person7", "Record", ["rPerson1"], "Make optional field required", [
      [2, "name", "String", ["[1"], "Require name"]
    ]],

    ["Building1", "Record", ["rClass1"], "Remove optional field", [
      [2, "name", "String", ["[0", "]0"], "max cardinality 0 - removed"]
    ]],

    ["Building2", "Record", ["rClass1"], "Error - remove required field", [
      [1, "id", "Integer", ["[0", "]0"], "cannot be both required and not allowed"]
    ]],

    ["Building3", "Record", ["rClass1"], "Error - restrictions cannot add new fields", [
      [2, "name", "String", ["[0","]0"], "remove optional field"],
      [3, "addr", "String", [], ""]
    ]]
  ]
}
